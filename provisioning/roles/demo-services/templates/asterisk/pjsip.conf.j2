; CallAnsible Asterisk PJSIP Configuration
; Generated by Ansible provisioning

[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0:{{ asterisk_sip_port }}

[transport-tcp]
type=transport
protocol=tcp
bind=0.0.0.0:{{ asterisk_sip_port }}

; Speaker's phone endpoint
[speaker-phone]
type=endpoint
context=callansible
disallow=all
allow=ulaw
allow=alaw
allow=opus
auth=speaker-phone-auth
aors=speaker-phone-aor
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes

[speaker-phone-auth]
type=auth
auth_type=userpass
username=speaker
password=${SIP_PASSWORD}

[speaker-phone-aor]
type=aor
max_contacts=1
remove_existing=yes
