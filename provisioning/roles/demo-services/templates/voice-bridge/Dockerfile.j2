# CallAnsible Voice Bridge Dockerfile
# Generated by Ansible provisioning

FROM {{ container_images.python }}

WORKDIR /app

# Install system dependencies for audio processing
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY *.py ./

# Create audio directory
RUN mkdir -p /audio

# Expose port
EXPOSE {{ voice_bridge_port }}

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:{{ voice_bridge_port }}/health || exit 1

# Run the application
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "{{ voice_bridge_port }}"]
