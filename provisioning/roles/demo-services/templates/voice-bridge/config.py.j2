"""
CallAnsible Voice Bridge Configuration
Generated by Ansible provisioning
"""

import os
from dataclasses import dataclass
from dotenv import load_dotenv

load_dotenv()


@dataclass
class Config:
    """Voice bridge configuration from environment variables."""

    # Asterisk ARI
    asterisk_ari_url: str = os.getenv("ASTERISK_ARI_URL", "http://localhost:{{ asterisk_ari_port }}")
    asterisk_ari_user: str = os.getenv("ASTERISK_ARI_USER", "voice-bridge")
    asterisk_ari_password: str = os.getenv("ASTERISK_ARI_PASSWORD", "")

    # vLLM
    vllm_url: str = os.getenv("VLLM_URL", "http://localhost:{{ vllm_port }}")

    # AAP
    aap_url: str = os.getenv("AAP_URL", "https://localhost:{{ aap_https_port }}")
    aap_user: str = os.getenv("AAP_USER", "admin")
    aap_password: str = os.getenv("AAP_PASSWORD", "")

    # STT (Whisper)
    whisper_model: str = os.getenv("WHISPER_MODEL", "{{ whisper_model }}")
    whisper_device: str = os.getenv("WHISPER_DEVICE", "{{ whisper_device }}")

    # TTS (Piper)
    piper_model_path: str = os.getenv(
        "PIPER_MODEL_PATH",
        "/models/piper/{{ piper_model }}.onnx"
    )

    # Audio
    audio_dir: str = os.getenv("AUDIO_DIR", "/audio")

    # Timeouts (seconds)
    silence_timeout: float = float(os.getenv("SILENCE_TIMEOUT", "0.8"))
    llm_timeout: float = float(os.getenv("LLM_TIMEOUT", "10.0"))
    aap_timeout: float = float(os.getenv("AAP_TIMEOUT", "30.0"))


config = Config()
