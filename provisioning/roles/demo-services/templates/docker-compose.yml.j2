# CallAnsible Docker Compose Configuration
# Generated by Ansible provisioning
#
# Usage:
#   podman-compose up -d
#   podman-compose logs -f
#   podman-compose down

version: "3.8"

services:
  # ==========================================================================
  # vLLM - Local LLM inference with GPU
  # ==========================================================================
  vllm:
    image: {{ container_images.vllm }}
    container_name: vllm
    command:
      - --model
      - {{ vllm_model }}
      - --quantization
      - {{ vllm_quantization }}
      - --gpu-memory-utilization
      - "{{ vllm_gpu_memory_utilization }}"
      - --max-model-len
      - "{{ vllm_max_model_len }}"
      - --port
      - "{{ vllm_port }}"
    environment:
      - NVIDIA_VISIBLE_DEVICES=all
    ports:
      - "{{ vllm_port }}:{{ vllm_port }}"
    devices:
      - nvidia.com/gpu=all
    deploy:
      resources:
        limits:
          memory: 16G
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:{{ vllm_port }}/health"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 120s
    restart: unless-stopped

  # ==========================================================================
  # Asterisk - SIP PBX
  # ==========================================================================
  asterisk:
    image: {{ container_images.asterisk }}
    container_name: asterisk
    network_mode: host
    volumes:
      - ./asterisk/pjsip.conf:/etc/asterisk/pjsip.conf:ro
      - ./asterisk/extensions.conf:/etc/asterisk/extensions.conf:ro
      - ./asterisk/ari.conf:/etc/asterisk/ari.conf:ro
      - ./asterisk/http.conf:/etc/asterisk/http.conf:ro
      - ./asterisk/rtp.conf:/etc/asterisk/rtp.conf:ro
      - ./audio:/var/lib/asterisk/sounds/custom:rw
    environment:
      - SIP_PASSWORD=${SIP_PASSWORD}
      - ARI_PASSWORD=${ARI_PASSWORD}
    healthcheck:
      test: ["CMD", "asterisk", "-rx", "core show version"]
      interval: 30s
      timeout: 10s
      retries: 3
    restart: unless-stopped

  # ==========================================================================
  # Voice Bridge - Call orchestration
  # ==========================================================================
  voice-bridge:
    build:
      context: ./voice-bridge
      dockerfile: Dockerfile
    container_name: voice-bridge
    network_mode: host
    volumes:
      - ./models/piper:/models/piper:ro
      - ./audio:/audio:rw
    environment:
      - ASTERISK_ARI_URL=http://localhost:{{ asterisk_ari_port }}
      - ASTERISK_ARI_USER=voice-bridge
      - ASTERISK_ARI_PASSWORD=${ARI_PASSWORD}
      - VLLM_URL=http://localhost:{{ vllm_port }}
      - AAP_URL=https://localhost:{{ aap_https_port }}
      - AAP_USER=admin
      - AAP_PASSWORD=${AAP_PASSWORD}
      - PIPER_MODEL_PATH=/models/piper/{{ piper_model }}.onnx
      - WHISPER_MODEL={{ whisper_model }}
      - WHISPER_DEVICE={{ whisper_device }}
    depends_on:
      vllm:
        condition: service_healthy
      asterisk:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:{{ voice_bridge_port }}/health"]
      interval: 30s
      timeout: 10s
      retries: 3
    restart: unless-stopped

  # ==========================================================================
  # AWX/AAP - Ansible Automation Platform
  # ==========================================================================
  aap:
    image: {{ container_images.awx }}
    container_name: aap
    ports:
      - "{{ aap_https_port }}:443"
      - "{{ aap_api_port }}:8043"
    volumes:
      - ./playbooks:/var/lib/awx/projects:rw
      - ./aap-data:/var/lib/awx/data:rw
    environment:
      - AWX_ADMIN_USER=admin
      - AWX_ADMIN_PASSWORD=${AAP_PASSWORD}
    healthcheck:
      test: ["CMD", "curl", "-fsk", "https://localhost/api/v2/ping/"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 60s
    restart: unless-stopped

  # ==========================================================================
  # EDA - Event-Driven Ansible
  # ==========================================================================
  eda:
    image: {{ container_images.eda }}
    container_name: eda
    command:
      - ansible-rulebook
      - -i
      - /inventory/hosts.yml
      - --rulebook
      - /rulebooks/storm_mode.yml
      - --websocket-address
      - 0.0.0.0:{{ eda_webhook_port }}
    ports:
      - "{{ eda_webhook_port }}:{{ eda_webhook_port }}"
    volumes:
      - ./eda/rulebooks:/rulebooks:ro
      - ./eda/inventory:/inventory:ro
    environment:
      - AAP_URL=https://localhost:{{ aap_https_port }}
      - AAP_TOKEN=${AAP_TOKEN}
    depends_on:
      aap:
        condition: service_healthy
    restart: unless-stopped

networks:
  default:
    name: callansible
    driver: bridge
