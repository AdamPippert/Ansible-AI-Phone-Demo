---
# CallAnsible Provisioning Credentials
# =====================================
#
# INSTRUCTIONS:
# 1. Copy this file to credentials.yml:
#    cp credentials.yml.example credentials.yml
#
# 2. Edit credentials.yml with your actual values:
#    vim credentials.yml
#
# 3. Secure the file permissions:
#    chmod 600 credentials.yml
#
# 4. NEVER commit credentials.yml to version control!
#
# Usage with playbook:
#   ansible-playbook -i inventory.yml site.yml -e @credentials.yml
#

credentials:
  # SSH username for the Framework 16 machine
  username: adam

  # SSH/sudo password for the user
  # This is used for ansible_become_password
  password: "changeme_ssh_password"

  # LUKS disk encryption password (if applicable)
  # Used for unlocking encrypted volumes during provisioning
  luks_password: "changeme_luks_password"
